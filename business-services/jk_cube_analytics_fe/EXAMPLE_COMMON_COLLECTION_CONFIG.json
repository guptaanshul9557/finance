  "screen_name": "Common Collection",
  "display_name": "Common Collection Dashboard",
  "route": "/modules/common-collection",
  "icon": "💰",
  "color": "#4CAF50",
  "enabled": true,
  "enable_in_homescreen": true,
  "enable_in_sidebar": false,
  "cube_name": "TresCollReceiptHdr",
  "table_name": "public.tres_coll_receipt_hdr",
  "financial_year": {
