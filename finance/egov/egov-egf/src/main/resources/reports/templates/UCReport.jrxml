				</box>
				<textField>
					<reportElement style="Base" x="0" y="0" width="515" height="200" uuid="5e6f7081-0005-4000-8000-000000000002"/>
					<textElement textAlignment="Justified" verticalAlignment="Top">
						<paragraph lineSpacing="Single"/>
					</textElement>
					<textFieldExpression><![CDATA["Certified that out of Rs"+ $F{grantAmount} +" Of grants sanctioned during the year "+ $F{financialYear} +" in favour of Municipal Corporation under the Ministry/Department Letter No "+ $F{ucNumber} +" dated ......... given in the margin and Rs " +$F{previousBalance}+" on account of unspent balance of the previous year, a sum of Rs "+ $F{utilisedAmount}+ " has been utilized for the purpose of "+ $F{purpose}+" for which it was sanctioned and that the balance of Rs"+ $F{unutilisedBalance}+" remaining unutilized at the end of the year has been surrendered to Government (vide No. ...........................dated.......................)/will be adjusted towards the grants payable during the next year........................................"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
		<band height="175" splitType="Stretch">
			<staticText>
				<reportElement style="Base" x="0" y="0" width="515" height="55" uuid="2b3c4d5e-0002-4000-8000-000000000001"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[2. Certified that I have satisfied myself that the conditions on which the grants-in-aid was sanctioned have been duly fulfilled/ are being fulfilled and that I have exercised the following checks to see that the money was actually utilized for the propose for which it was sanctioned.]]></text>
			</staticText>
		</band>
		<band height="75" splitType="Stretch">
			<textField>
				<reportElement style="Base" x="285" y="-102" width="230" height="18" uuid="3c4d5e6f-0003-4000-8000-000000000001"/>
				<textFieldExpression><![CDATA["Signature: "+$F{signatoryName}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Base" x="285" y="-82" width="230" height="18" uuid="3c4d5e6f-0003-4000-8000-000000000002"/>
				<textFieldExpression><![CDATA["Designation: "+$F{signatoryDesignation}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Base" x="285" y="-62" width="230" height="18" uuid="3c4d5e6f-0003-4000-8000-000000000003"/>
				<textFieldExpression><![CDATA["Date: "+$F{certificateDate}]]></textFieldExpression>
			</textField>
		</band>
		<band height="70" splitType="Stretch">
			<staticText>
				<reportElement style="Base" x="0" y="0" width="515" height="65" uuid="4d5e6f70-0004-4000-8000-000000000001"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10"/>
				</textElement>
				<text><![CDATA[PS: The UC shall disclose separately the actual expenditure incurred and loans and advances given to suppliers of stores and assets, to construction agencies and like in accordance with scheme guidelines and in furtherance to the scheme objectives, which do not constitute expenditure at the stage. These shall be treated as utilized grants but allowed to be carried forward.]]></text>
			</staticText>
		</band>
